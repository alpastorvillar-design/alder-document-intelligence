# Copy to .env and adjust. Never commit a real .env.

# --- Database ---------------------------------------------------------------
IEP_DATABASE_URL=postgresql+psycopg://iep:iep@postgres:5432/iep
POSTGRES_USER=iep
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=iep

# --- Object storage ---------------------------------------------------------
# Local filesystem backend. Content-addressed; never serves caller-supplied names.
IEP_STORAGE_ROOT=/var/lib/iep/objects

# --- Ingestion limits -------------------------------------------------------
IEP_MAX_UPLOAD_BYTES=20971520
IEP_MAX_PDF_PAGES=100
IEP_MAX_EXCEL_CELLS=200000
IEP_MAX_DECOMPRESSED_BYTES=104857600

# --- Worker -----------------------------------------------------------------
IEP_WORKER_POLL_SECONDS=1.0
IEP_JOB_MAX_ATTEMPTS=3
IEP_JOB_LEASE_SECONDS=120

# --- Semantic extraction ----------------------------------------------------
# deterministic | llm
IEP_SEMANTIC_PROVIDER=deterministic
IEP_LLM_BASE_URL=https://api.anthropic.com
IEP_LLM_MODEL=claude-sonnet-5
IEP_LLM_TIMEOUT_SECONDS=30
IEP_LLM_MAX_ATTEMPTS=2
# Leave empty. The llm provider refuses to start without an explicit key, and
# no test or demo path in this repository calls a billable endpoint.
IEP_LLM_API_KEY=

# --- Connectors -------------------------------------------------------------
IEP_REGISTRY_API_BASE_URL=http://devsources:8080
IEP_REGISTRY_API_TOKEN=local-development-token
IEP_SCRAPER_ALLOWLIST=devsources,localhost,127.0.0.1
IEP_SCRAPER_MAX_BYTES=1048576
IEP_SCRAPER_USER_AGENT=innovation-evidence-pipeline/0.1 (+contact: set-in-deployment)

# --- API --------------------------------------------------------------------
# Optional shared-secret gate. Empty disables it; see docs/threat-model.md for
# why this is not authentication.
IEP_API_KEY=
IEP_LOG_LEVEL=INFO
