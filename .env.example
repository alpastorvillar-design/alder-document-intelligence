# Copy to .env and adjust. Never commit a real .env.

# --- Database ---------------------------------------------------------------
IEP_DATABASE_URL=postgresql+psycopg://iep:iep@postgres:5432/iep
POSTGRES_USER=iep
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=iep

# --- Object storage ---------------------------------------------------------
# Local filesystem backend. Content-addressed; never serves caller-supplied names.
IEP_STORAGE_ROOT=/var/lib/iep/objects

# --- Ingestion limits -------------------------------------------------------
IEP_MAX_UPLOAD_BYTES=20971520
IEP_MAX_PDF_PAGES=100
IEP_MAX_IMAGE_PIXELS=40000000
IEP_MAX_EXCEL_CELLS=200000
IEP_MAX_DECOMPRESSED_BYTES=104857600

# --- Worker -----------------------------------------------------------------
IEP_WORKER_POLL_SECONDS=1.0
IEP_JOB_MAX_ATTEMPTS=3
IEP_JOB_LEASE_SECONDS=120
IEP_OCR_TIMEOUT_SECONDS=30

# --- Semantic extraction ----------------------------------------------------
# deterministic | llm
IEP_SEMANTIC_PROVIDER=deterministic
IEP_LLM_BASE_URL=https://api.anthropic.com
IEP_LLM_MODEL=claude-sonnet-5
IEP_LLM_TIMEOUT_SECONDS=30
IEP_LLM_MAX_ATTEMPTS=2
# Leave empty. The llm provider refuses to start without an explicit key, and
# no test or demo path in this repository calls a billable endpoint.
IEP_LLM_API_KEY=

# --- Retrieval and optional RAG ---------------------------------------------
# `hashing` is an offline deterministic baseline. It proves vector persistence,
# dossier isolation and hybrid ranking, but it is not a learned embedding model.
# Set `openai` only for an explicitly authorised hosted-model run.
#  - `ollama` uses a locally configured multilingual model, with no key or
#    network egress. This turns vector search from a plumbing demonstration
#    into actual semantic retrieval when the model is available.
IEP_EMBEDDING_PROVIDER=hashing
IEP_OLLAMA_BASE_URL=http://localhost:11434
IEP_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
IEP_OPENAI_BASE_URL=https://api.openai.com/v1
IEP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Cosine similarity below which a vector hit is dropped. Left unset it is 0 -
# off - for every provider available here, from measurement: three widenings
# of the query set gave three different "right" thresholds, and the last one
# showed a tuned value cutting a legitimate question while passing noise.
# docs/rag.md carries all three tables.
# IEP_RETRIEVAL_MIN_SIMILARITY=
# `disabled` keeps every default path offline.
#  - `openai` enables the read-only grounded-answer endpoint, and also needs
#    the separate external-AI opt-in below.
#  - `cli` answers through `claude` or `codex` on this host, so a demonstration
#    needs no API key. Development only; the binary has to be on the API
#    process's PATH, which a container does not have. See docs/rag.md.
IEP_RAG_PROVIDER=disabled
IEP_OPENAI_RAG_MODEL=gpt-4o-mini
IEP_ALLOW_EXTERNAL_AI=false
IEP_RAG_CLI_TOOL=claude
IEP_RAG_CLI_MODEL=
IEP_RAG_CLI_TIMEOUT_SECONDS=120
# A ceiling this application enforces on itself, counted from the audit trail
# over a rolling window, refusing at the stop fraction rather than warning.
# Not the remaining quota of a subscription: no API publishes that. 0 = none.
IEP_RAG_CALL_BUDGET=40
IEP_RAG_BUDGET_WINDOW_DAYS=7
IEP_RAG_BUDGET_STOP_FRACTION=0.90
# Never commit a real value. Supply it only in the local process environment or
# an untracked .env file with restrictive permissions.
IEP_OPENAI_API_KEY=

# --- Connectors -------------------------------------------------------------
IEP_REGISTRY_API_BASE_URL=http://devsources:8080
IEP_REGISTRY_API_TOKEN=local-development-token
IEP_REGISTRY_API_MAX_BYTES=2097152
IEP_SCRAPER_ALLOWLIST=devsources,localhost,127.0.0.1
IEP_SCRAPER_MAX_BYTES=1048576
IEP_SCRAPER_USER_AGENT=innovation-evidence-pipeline/0.1 (+contact: set-in-deployment)

# --- API --------------------------------------------------------------------
# Optional shared-secret gate. Empty disables it; see docs/threat-model.md for
# why this is not authentication.
IEP_API_KEY=
IEP_LOG_LEVEL=INFO
