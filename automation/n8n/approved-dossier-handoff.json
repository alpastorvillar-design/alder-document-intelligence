              "type": "string"
            },
            {
              "id": "pick2",
              "name": "reference",
              "value": "={{ $json.reference || $('Read the request').first().json.reference }}",
              "type": "string"
            },
            {
              "id": "pick3",
              "name": "status",
              "value": "={{ $json.status || 'NOT_FOUND' }}",
              "type": "string"
            },
            {
              "id": "pick4",
              "name": "apiBaseUrl",
              "value": "={{ $('Read the request').first().json.apiBaseUrl }}",
              "type": "string"
            },
            {
              "id": "pick5",
              "name": "reviewBaseUrl",
              "value": "={{ $('Read the request').first().json.reviewBaseUrl }}",
              "type": "string"
            },
            {
              "id": "pick6",
