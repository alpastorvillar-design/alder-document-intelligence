              "type": "string"
            },
            {
              "id": "req2",
              "name": "apiBaseUrl",
              "value": "={{ $env.IEP_API_BASE_URL || 'http://api:8000' }}",
              "type": "string"
            },
            {
              "id": "req3",
              "name": "reviewBaseUrl",
              "value": "={{ $env.IEP_REVIEW_BASE_URL || 'http://127.0.0.1:8000' }}",
              "type": "string"
            },
            {
              "id": "req4",
              "name": "correlationId",
              "value": "={{ 'n8n-handoff-' + $execution.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000003",
