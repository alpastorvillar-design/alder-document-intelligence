        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "={{ $json.correlationId }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Find the dossier",
